{
  "name": "cardrush-video",
  "version": "1.0.0",
  "description": "Vídeo de apresentação do CardRush (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "record": "cd .. && npx playwright test -c video/record/playwright.config.ts",
    "sfx": "node scripts/make-sfx.mjs",
    "render": "remotion render CardRush out/cardrush-apresentacao.mp4 --codec=h264 --crf=18",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "publish": "node scripts/publish.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
