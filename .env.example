# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cardrush?schema=public"

# Better Auth — gere o secret com: npx @better-auth/cli secret (mín. 32 caracteres)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Chaves separadas (mín. 32 caracteres cada, diferentes entre si).
# Vazias em desenvolvimento usam um valor padrão; em produção o app não sobe com ele.
AUDIT_SECRET=""
PSEUDONYM_SECRET=""
TURNSTILE_PASS_SECRET=""

# Modo de teste (relógio controlável, modos simulados, rotas /api/test). Proibido em produção.
TEST_MODE="0"

# Cloudflare Turnstile — padrão de desenvolvimento: chaves de teste que sempre passam.
# Site key que falha: 2x00000000000000000000BB
# Secret que reprova: 2x0000000000000000000000000000000AA · token duplicado: 3x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000BB"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TURNSTILE_ENFORCE="1"

# Usuários criados por `npm run db:seed`
SEED_EMAIL="helena.duarte@cardrush.com"
SEED_PASSWORD=""
SEED_BIDDER_PASSWORD=""

# Rota que fecha lotes vencidos (GET/POST /api/cron/close-lots com "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""
# Varredura de lotes vencidos no próprio processo, em ms (0 = desligada; em produção usar cron externo)
SETTLEMENT_SWEEP_MS="5000"

# Banco dos testes E2E (npm run test:e2e). Use um banco ou schema separado: o reset dos testes apaga os dados.
# Neon: endpoint direto (sem -pooler) + ?schema=e2e, e rode `DATABASE_URL=<esta url> npx prisma migrate deploy` uma vez.
E2E_DATABASE_URL=""

# Mostra cada consulta SQL no terminal (só para depurar)
PRISMA_LOG_QUERIES="0"

# Conexão direta usada pelas migrations (no Neon: o mesmo endereço sem "-pooler").
# Sem pooler, use o mesmo valor de DATABASE_URL.
DIRECT_DATABASE_URL=""
